# Copiar este archivo como .env y completar los valores
VITE_PA_REQUISICION_URL=
VITE_PA_DESEMPENO_ESTRATEGICO_URL=
VITE_PA_PEOPLE_URL=

# Variables SOLO del servidor (sin prefijo VITE_ = nunca llegan al navegador)
# Contraseña de acceso al portal (mín. 12 chars, mayúsc., minúsc., números, car. especial)
APP_PASSWORD=
# Clave secreta para firmar los tokens JWT (string aleatorio largo, ej: openssl rand -hex 32)
APP_JWT_SECRET=
